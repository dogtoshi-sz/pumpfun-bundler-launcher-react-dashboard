# Data Storage Directory (optional - for cloud deployments)
# If not set, defaults to ./keys (relative to process.cwd())
# For cloud deployments, use persistent storage:
#   - Docker: DATA_DIR=/data/keys (mount a volume)
#   - Railway: DATA_DIR=/app/data/keys (use persistent volume)
#   - AWS: DATA_DIR=/mnt/efs/keys (use EFS)
#   - Local: Leave empty to use default ./keys
# DATA_DIR=

PRIVATE_KEY=""
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=
RPC_WEBSOCKET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=

# OpenAI API Key (optional - for AI auto-fill feature)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

LIL_JIT_ENDPOINT = https://blue-bitter-mountain.solana-mainnet.quiknode.pro/
LIL_JIT_WEBSOCKET_ENDPOINT = wss://blue-bitter-mountain.solana-mainnet.quiknode.pro/

LIL_JIT_MODE="false"

SWAP_AMOUNT=1             
DISTRIBUTION_WALLETNUM=16       

JITO_FEE=0.001

TOKEN_NAME="VENOM PROTOCOL"
TOKEN_SYMBOL="VNM"
DESCRIPTION='VENOM PROTOCOL is the world's first AI-powered trading terminal for Solana'
TOKEN_SHOW_NAME="MN"
# TOKEN_CREATE_ON: Metadata field - where the token was created (e.g., "https://pump.fun" or "https://bonk.fun")
# This is just metadata stored with the token, doesn't affect functionality
TOKEN_CREATE_ON="https://pump.fun"
# Optional: Social links (can be empty strings)
TWITTER=""
TELEGRAM=""
WEBSITE=""
FILE="./image/2.jpg"
VANITY_MODE="false"
# Optional: Use a pregenerated mint keypair (base58 private key)
# If not set, a new mint keypair will be generated each time
# MINT_PRIVATE_KEY=""
BUYER_WALLET=""
BUYER_AMOUNT=
AUTO_RAPID_SELL=true
AUTO_SELL_50_PERCENT=false
AUTO_GATHER=false
AUTO_COLLECT_FEES=false
