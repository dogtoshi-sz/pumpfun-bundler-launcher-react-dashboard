# Data Storage Directory (optional - for cloud deployments)
# If not set, defaults to ./keys (relative to process.cwd())
# For cloud deployments, use persistent storage:
#   - Docker: DATA_DIR=/data/keys (mount a volume)
#   - Railway: DATA_DIR=/app/data/keys (use persistent volume)
#   - AWS: DATA_DIR=/mnt/efs/keys (use EFS)
#   - Local: Leave empty to use default ./keys
# DATA_DIR=

PRIVATE_KEY=""
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=
RPC_WEBSOCKET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=

# OpenAI API Key (optional - for AI auto-fill feature)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

LIL_JIT_ENDPOINT = https://blue-bitter-mountain.solana-mainnet.quiknode.pro/
LIL_JIT_WEBSOCKET_ENDPOINT = wss://blue-bitter-mountain.solana-mainnet.quiknode.pro/

LIL_JIT_MODE="false"

SWAP_AMOUNT=1             
DISTRIBUTION_WALLETNUM=16       

JITO_FEE=0.001

TOKEN_NAME="VENOM PROTOCOL"
TOKEN_SYMBOL="VNM"
DESCRIPTION='VENOM PROTOCOL is the world's first AI-powered trading terminal for Solana'
TOKEN_SHOW_NAME="MN"
# TOKEN_CREATE_ON: Metadata field - where the token was created (e.g., "https://pump.fun" or "https://bonk.fun")
# This is just metadata stored with the token, doesn't affect functionality
TOKEN_CREATE_ON="https://pump.fun"
# Optional: Social links (can be empty strings)
TWITTER=""
TELEGRAM=""
WEBSITE=""
FILE="./image/2.jpg"
VANITY_MODE="false"
# Optional: Use a pregenerated mint keypair (base58 private key)
# If not set, a new mint keypair will be generated each time
# MINT_PRIVATE_KEY=""
BUYER_WALLET=""
BUYER_AMOUNT=
AUTO_RAPID_SELL=true
AUTO_SELL_50_PERCENT=false
AUTO_GATHER=false
AUTO_COLLECT_FEES=false

# WebSocket Tracking (real-time buy/sell detection and auto-sell)
# Enable real-time tracking that starts automatically after wallets are created
WEBSOCKET_TRACKING_ENABLED=false
# External buy threshold (cumulative SOL) - triggers auto-sell when reached
WEBSOCKET_EXTERNAL_BUY_THRESHOLD=1.0
# Time window in seconds to aggregate external buys
WEBSOCKET_EXTERNAL_BUY_WINDOW=60
# Ultra-fast mode (sub-500ms reaction time) - uses 'processed' commitment and pre-built transactions
# Set to 'true' for maximum speed, 'false' for standard reliable mode
WEBSOCKET_ULTRA_FAST_MODE=false

# Priority fees for Jupiter swaps (in lamports) - higher = faster confirmation
# HIGH priority: Used when WebSocket threshold is met (auto-sell) - must be fast!
# Default: 5,000,000 lamports (0.005 SOL) - reduces confirmation from ~4s to ~1s
# For extreme speed, increase to 10,000,000 (0.01 SOL) or higher
# PRIORITY_FEE_LAMPORTS_HIGH=5000000

# LOW priority: Used for manual sells or when threshold isn't met - save money!
# Default: 100,000 lamports (0.0001 SOL) - cheap but slower confirmation (~4-5s)
# PRIORITY_FEE_LAMPORTS_LOW=100000
