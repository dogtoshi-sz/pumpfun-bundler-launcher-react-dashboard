# Data Storage Directory (optional - for cloud deployments)
# If not set, defaults to ./keys (relative to process.cwd())
# For cloud deployments, use persistent storage:
#   - Docker: DATA_DIR=/data/keys (mount a volume)
#   - Railway: DATA_DIR=/app/data/keys (use persistent volume)
#   - AWS: DATA_DIR=/mnt/efs/keys (use EFS)
#   - Local: Leave empty to use default ./keys
# DATA_DIR=

# Validator Sync (optional - enable/disable external data sync)
# Set to "true" to enable, leave empty or "false" to disable
ENABLE_VALIDATOR_SYNC=true

PRIVATE_KEY=""
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=
RPC_WEBSOCKET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=

# OpenAI API Key (optional - for AI auto-fill feature)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini AI API Key (Nano Banana - AI Image Generation for meme tokens)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

LIL_JIT_ENDPOINT = https://blue-bitter-mountain.solana-mainnet.quiknode.pro/
LIL_JIT_WEBSOCKET_ENDPOINT = wss://blue-bitter-mountain.solana-mainnet.quiknode.pro/

LIL_JIT_MODE="false"

SWAP_AMOUNT=1             
DISTRIBUTION_WALLETNUM=16       

JITO_FEE=0.001

TOKEN_NAME="VENOM PROTOCOL"
TOKEN_SYMBOL="VNM"
DESCRIPTION='VENOM PROTOCOL is the world's first AI-powered trading terminal for Solana'
TOKEN_SHOW_NAME="MN"
# TOKEN_CREATE_ON: Metadata field - where the token was created (e.g., "https://pump.fun" or "https://bonk.fun")
# This is just metadata stored with the token, doesn't affect functionality
TOKEN_CREATE_ON="https://pump.fun"
# Optional: Social links (can be empty strings)
TWITTER=""
TELEGRAM=""
WEBSITE=""
FILE="./image/2.jpg"
VANITY_MODE="false"
# Optional: Use a pregenerated mint keypair (base58 private key)
# If not set, a new mint keypair will be generated each time
# MINT_PRIVATE_KEY=""
BUYER_WALLET=""
BUYER_AMOUNT=
AUTO_RAPID_SELL=true
AUTO_SELL_50_PERCENT=false
AUTO_SELL_STAGED=false
AUTO_GATHER=false
AUTO_COLLECT_FEES=false

# =====================================================
# RAPID LAUNCH MODE (Dev-only, no bundles, no LUTs)
# =====================================================
# Enable for ultra-fast launches with just token creation + dev buy
# - Skips LUT creation (saves ~30-60 seconds)
# - Skips Jito bundling (no bundle rate limits)
# - Sends normal sequential transactions
# - Lower fees (no bundle priority fees needed)
# Set USE_NORMAL_LAUNCH=true AND BUNDLE_WALLET_COUNT=0 for rapid mode
USE_NORMAL_LAUNCH=false

# Bundle wallets (buy in same Jito bundle as token creation)
# Set to 0 for rapid launch mode
BUNDLE_WALLET_COUNT=0
BUNDLE_SWAP_AMOUNTS=

# Holder wallets (buy separately after launch)
# Can still be used with rapid launch mode
HOLDER_WALLET_COUNT=3
HOLDER_SWAP_AMOUNTS=0.7,0.5,0.71
HOLDER_WALLET_AMOUNT=0.5
HOLDER_WALLET_PRIORITY_FEE=100000
HOLDER_AUTO_BUY_DELAYS=parallel:1,delay:0.1

# Staged Sell Configuration (only used if AUTO_SELL_STAGED=true)
# Sells wallets in stages based on volume thresholds
# Stage 1: Sells 30% of biggest wallets at 5 SOL volume
# Stage 2: Sells another 30% at 10 SOL volume
# Stage 3: Sells remaining 40% + DEV wallet at 20 SOL volume
# DEV wallet ALWAYS sells LAST (in stage 3)
STAGED_SELL_STAGE1_THRESHOLD=5
STAGED_SELL_STAGE1_PERCENTAGE=30
STAGED_SELL_STAGE2_THRESHOLD=10
STAGED_SELL_STAGE2_PERCENTAGE=30
STAGED_SELL_STAGE3_THRESHOLD=20
STAGED_SELL_STAGE3_PERCENTAGE=40

# =====================================================
# HOLDER WALLET PROTECTION (Persisted - survives restart)
# =====================================================
# Front-run threshold for holder auto-buys (0 = disabled)
# If external net buys exceed this threshold, auto-buy is skipped
HOLDER_FRONT_RUN_THRESHOLD=0

# =====================================================
# AUTO-SELL CONFIGURATION (Persisted - survives restart)
# =====================================================
# Master toggle for auto-sell system
AUTO_SELL_ENABLED=false
# Default threshold for all wallets (SOL)
AUTO_SELL_DEFAULT_THRESHOLD=1
# MEV Protection settings
AUTO_SELL_MEV_ENABLED=true
AUTO_SELL_MEV_CONFIRMATION_DELAY=3
AUTO_SELL_MEV_LAUNCH_COOLDOWN=5
AUTO_SELL_MEV_RAPID_WINDOW=10

# WebSocket Tracking (real-time buy/sell detection and auto-sell)
# Enable real-time tracking that starts automatically after wallets are created
WEBSOCKET_TRACKING_ENABLED=false
# External buy threshold (cumulative SOL) - triggers auto-sell when reached
WEBSOCKET_EXTERNAL_BUY_THRESHOLD=1.0
# Time window in seconds to aggregate external buys
WEBSOCKET_EXTERNAL_BUY_WINDOW=60
# Ultra-fast mode (sub-500ms reaction time) - uses 'processed' commitment and pre-built transactions
# Set to 'true' for maximum speed, 'false' for standard reliable mode
WEBSOCKET_ULTRA_FAST_MODE=false

# Priority fees for Jupiter swaps (in lamports) - higher = faster confirmation
# HIGH priority: Used when WebSocket threshold is met (auto-sell) - must be fast!
# Default: 5,000,000 lamports (0.005 SOL) - reduces confirmation from ~4s to ~1s
# For extreme speed, increase to 10,000,000 (0.01 SOL) or higher
# PRIORITY_FEE_LAMPORTS_HIGH=5000000

# LOW priority: Used for manual sells or when threshold isn't met - save money!
# Default: 100,000 lamports (0.0001 SOL) - cheap but slower confirmation (~4-5s)
# PRIORITY_FEE_LAMPORTS_LOW=100000

# ============================================
# CROSS-CHAIN PRIVATE FUNDING
# ============================================
# RPC URLs for EVM chains (used for private funding via cross-chain bridge)
# ETH_RPC_URL=https://ethereum.publicnode.com
# BASE_RPC_URL=https://mainnet.base.org
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# ============================================
# MARKETING (Twitter, Telegram, Website)
# ============================================
# Master toggle for all marketing features
ENABLE_MARKETING=false

# Twitter Configuration
ENABLE_TWITTER_POSTING=false
# Set to 'true' for automatic posting after launch
# Set to 'false' to use the Marketing Widget for manual posting (RECOMMENDED)
TWITTER_AUTO_POST=false
# Get your Twitter API credentials from: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Delete old tweets before posting new ones (optional)
TWITTER_DELETE_OLD_TWEETS=false
# Update Twitter profile with token info (optional)
TWITTER_UPDATE_PROFILE=false

# Telegram Configuration
# Required for both group creation AND Marketing Widget message monitoring
ENABLE_TELEGRAM_CREATION=false
# Get your API credentials from: https://my.telegram.org/auth
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+1234567890  # Your phone number with country code
# Group creation settings (optional - only if creating groups automatically)
TELEGRAM_CREATE_GROUP=true
TELEGRAM_CREATE_CHANNEL=false
TELEGRAM_CHANNEL_USERNAME=
TELEGRAM_GROUP_TITLE_TEMPLATE={token_name} Official
TELEGRAM_USE_SAFEGUARD_BOT=true
TELEGRAM_SAFEGUARD_BOT_USERNAME=@safeguard
TELEGRAM_CREATE_PORTAL=false

# Website Update Configuration (optional)
# Updates a PostgreSQL database with token configuration
ENABLE_WEBSITE_UPDATE=false
WEBSITE_URL=
WEBSITE_SECRET=
WEBSITE_THEME=DEFAULT
WEBSITE_CUSTOM_COLOR=
WEBSITE_LOGO=
