# ============================================================
# 🔒 PRODUCTION ENVIRONMENT - API SERVER
# ============================================================
# 
# ⚠️  SECURITY WARNING:
# - DO NOT add any private keys or secret keys here
# - DO NOT add PRIVATE_KEY, SECRET_KEY, or wallet credentials
# - All signing happens CLIENT-SIDE in the browser
# - This server NEVER handles private keys
#
# ============================================================

# Required: Set to production
NODE_ENV=production

# Required: Your Helius RPC endpoint
# Get one at https://helius.dev
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Optional: Fallback RPC (public, rate-limited)
RPC_URL=https://api.mainnet-beta.solana.com

# Server port (Railway sets this automatically)
PORT=3001

# ============================================================
# ⛔ DO NOT ADD THESE IN PRODUCTION:
# ============================================================
# PRIVATE_KEY=...        ❌ NEVER
# SECRET_KEY=...         ❌ NEVER
# FUNDING_WALLET_KEY=... ❌ NEVER
# DEV_WALLET_KEY=...     ❌ NEVER
# ============================================================
